<main class="main">
  <div class="chats__left-panel">
    <div class="chats__wrapper">
      <div class="chats__link-container">
        <a class="chats__link chats__profile-link">Profile &gt;</a>
      </div>

      <div class="chats__search-container">
        <input class="chats__search-input" type="text" id="search" name="search" placeholder="Search" />
        <button class="chats__add-chat-button" id="add-chat-button" title="Создать новый чат">+</button>
      </div>

      <ul class="chats__list">
        {{#each chats}}
        <li class="chat {{#if (eq id ../selectedChatId)}}chat--selected{{/if}}" data-chat-id="{{id}}">
          <div class="chat__main-info">
            {{#if avatar}}
            <img class="chat__img" src="{{../resourcesBaseUrl}}{{avatar}}" alt="{{title}}" />
            {{else}}
            <img class="chat__img" src="/icons/chat-svgrepo-com.svg" alt="{{title}}" />
            {{/if}}
            <div class="chat__info">
              <p class="chat__name">{{title}}</p>
              {{#if last_message}}
              <p class="chat__message">{{last_message.content}}</p>
              {{else}}
              <p class="chat__message">No messages yet</p>
              {{/if}}
            </div>
          </div>
          <div class="chat__metadata">
            {{#if last_message}}
            <p class="chat__time">{{last_message.time}}</p>
            {{/if}}
            {{#if unread_count}}
            {{#if (gt unread_count 0)}}
            <div class="chat__number-of-unread-messages">{{unread_count}}</div>
            {{/if}}
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
  <div class="chats__current-chat">
    {{#if selectedChatTitle}}
    <div class="chat__current-header">
      <div class="chat__current-header-info">
        <img class="chat__current-img" src="/icons/gendalf_smile.jpg" alt="current user" />
        <p class="chat__current-name">{{selectedChatTitle}}</p>
      </div>
      <div class="chat__menu-wrapper">
        <img class="chat__attach-icon chat__menu-button" src="/icons/three-dots-svgrepo-com.svg" alt="menu" />
        <div class="chat__menu-dropdown" id="chat-menu-dropdown">
          <div class="chat__menu-item" id="add-user-menu-item">Добавить пользователя</div>
          <div class="chat__menu-item" id="delete-user-menu-item">Удалить пользователя</div>
          <div class="chat__menu-item" id="change-chat-avatar-menu-item">Изменить аватар чата</div>
          <div class="chat__menu-item chat__menu-item_danger" id="delete-chat-menu-item">Удалить чат</div>
        </div>
      </div>
    </div>

    <div class="mainchat__content" id="messages-container">
      <div class="mainchat__messages-wrapper" id="messages-wrapper">
        <!-- Здесь рендерятся сообщения -->
      </div>
    </div>

    <div class="chat__footer">
      <form class="chat__form">
        <img class="chat__attach-icon" src="/icons/attach-svgrepo-com.svg" alt="attach" />
        <input class="chat__send-message-input" type="text" id="message" name="message" placeholder="Send message" />
        <button type="submit" class="chat__send-message-button">
          <img class="chat__attach-icon" src="/icons/arrow-right-circle-svgrepo-com.svg" alt="send" />
        </button>
      </form>
    </div>
    {{else}}
    <div class="chats__empty-state">
      <p class="chats__empty-message">Выберите чат чтобы отправить сообщение</p>
    </div>
    {{/if}}
  </div>

  <!-- Модалка добавления пользователя -->
  <div class="modal" id="add-user-modal">
    <div class="modal__content">
      <div class="modal__header">
        <h3>Добавить пользователя</h3>
        <button class="modal__close" id="close-add-user-modal">&times;</button>
      </div>
      <form class="modal__form" id="add-user-form">
        <input type="text" id="user-login-input" placeholder="Логин пользователя" required />
        <button type="submit" class="modal__submit">Добавить</button>
      </form>
    </div>
  </div>

  <!-- Модалка удаления пользователя -->
  <div class="modal" id="delete-user-modal">
    <div class="modal__content">
      <div class="modal__header">
        <h3>Удалить пользователя</h3>
        <button class="modal__close" id="close-delete-user-modal">&times;</button>
      </div>
      <form class="modal__form" id="delete-user-form">
        <select id="delete-user-select" required>
          {{#if chatUsers.length}}
          {{#each chatUsers}}
          <option value="{{id}}">
            {{#if display_name}}{{display_name}}{{else}}{{first_name}} {{second_name}}{{/if}} ({{login}})
          </option>
          {{/each}}
          {{else}}
          <option value="">Нет пользователей для удаления</option>
          {{/if}}
        </select>
        <button type="submit" class="modal__submit">Удалить</button>
      </form>
    </div>
  </div>

  <!-- Модалка создания нового чата -->
  <div class="modal" id="create-chat-modal">
    <div class="modal__content">
      <div class="modal__header">
        <h3>Создать новый чат</h3>
        <button class="modal__close" id="close-create-chat-modal">&times;</button>
      </div>
      <form class="modal__form" id="create-chat-form">
        <input type="text" id="create-chat-title-input" placeholder="Название чата" required />
        <button type="submit" class="modal__submit">Создать чат</button>
      </form>
    </div>
  </div>

  <!-- Модалка изменения аватара чата -->
  <div class="modal" id="change-chat-avatar-modal">
    <div class="modal__content">
      <div class="modal__header">
        <h3>Изменить аватар чата</h3>
        <button class="modal__close" id="close-change-chat-avatar-modal">&times;</button>
      </div>
      <form class="modal__form" id="change-chat-avatar-form">
        <input type="file" id="chat-avatar-input" accept="image/*" required />
        <button type="submit" class="modal__submit">Сохранить</button>
      </form>
    </div>
  </div>
</main>
