{
  "name": "fantastic-waffle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && node server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "TS_NODE_PROJECT=tsconfig.test.json TS_NODE_FILES=true NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm --loader ./test/asset-loader.mjs' mocha --extension ts --file ./test/setup.ts \"src/**/*.test.ts\"",
    "test:watch": "TS_NODE_PROJECT=tsconfig.test.json TS_NODE_FILES=true NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm --loader ./test/asset-loader.mjs' mocha --watch --extension ts --file ./test/setup.ts \"src/**/*.test.ts\"",
    "lint": "eslint src/**/*.ts --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "precommit": "npm run lint && npm run stylelint && npm run test",
    "prepare": "husky install",
    "stylelint": "npx stylelint '**/*.scss'"
  },
  "overrides": {
    "diff": "^8.0.3",
    "rollup": "^4.59.0",
    "serialize-javascript": "^7.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^28.0.0",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.3",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "husky": "^8.0.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "handlebars": "^4.7.8"
  }
}
